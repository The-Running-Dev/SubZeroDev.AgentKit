# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Per-machine Claude Code settings; the tracked settings.json is deliberate
.claude/settings.local.json

# Per-machine session costs, written by the SessionEnd hook. Regenerable from
# the transcripts at any time, and meaningless on another machine.
.claude/session-costs.tsv

# Per-machine junction so Claude Code discovers this repo's skills/ as
# project skills. Not portable across machines/OSes; recreate with
# `mklink /J .claude/skills skills` on Windows.
.claude/skills/

# graphify — regenerable and expensive; never commit
graphify-out/
.graphify_*

# Videowright (videos/)
videos/node_modules/
videos/.env
